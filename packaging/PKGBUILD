# Maintainer: Xscriptor <dev@xscriptor.com>
pkgname=x-scripts
pkgver=0.1.0
pkgrel=14
pkgdesc="x provisioning payload and CLI (reboot)"
arch=('any')
url="https://github.com/xlnux/scripts"
license=('MIT')
depends=('bash')
source=()
md5sums=()

package() {
    local dest="$pkgdir/usr/share/x"
    install -d "$dest" "$pkgdir/usr/bin"

    for d in bin install skel etc config hardware tools migrations themes hooks; do
        [ -e "$startdir/../$d" ] && cp -a "$startdir/../$d" "$dest/"
    done

    # Offline desktop snapshot (equisdots stack + kitty/starship/nvim)
    # produced by vendor-config.sh. When present it is merged into
    # /usr/share/x/config so tools/hyprland-install.sh can deploy the whole
    # equisdots desktop without cloning external repos. No remote source=()
    # entries: the snapshot is vendored in-repo, not fetched at build time.
    if [[ -d "$startdir/.vendor/x-config" ]]; then
        install -d "$dest/config"
        cp -a "$startdir/.vendor/x-config/." "$dest/config/"
    fi

    find "$dest/bin" "$dest/install" "$dest/hardware" "$dest/tools" "$dest/hooks" -type f \( -name '*.sh' -o -name 'x' \) -exec chmod +x {} +

    ln -s /usr/share/x/bin/x "$pkgdir/usr/bin/x"
}
