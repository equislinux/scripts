# Maintainer: Xscriptor <dev@xscriptor.com>
pkgname=x-scripts
pkgver=0.1.0
pkgrel=52
pkgdesc="x provisioning payload and CLI (reboot)"
arch=('any')
url="https://github.com/equislinux/scripts"
license=('MIT')
install=x-scripts.install
# The engine shells out to these core tools plus btrfs-progs. pacman is only
# an optional fallback for the explicit pacman backend (see optdepends).
depends=('bash' 'btrfs-progs' 'coreutils' 'curl' 'gnupg' 'util-linux')
optdepends=(
    'pacman: fallback for the explicit pacman backend'
    'gnupg: signed and encrypted generation export/import (--sign, --encrypt)'
    'zstd: zstd-compressed export bundles (falls back to gzip)'
    'git: fetch desktop/theming sources (x theme, x setup)'
)
source=()
md5sums=()

package() {
    local dest="$pkgdir/usr/share/x"
    install -d "$dest" "$pkgdir/usr/bin"

    for d in bin install skel etc config hardware tools migrations themes hooks; do
        [ -e "$startdir/../$d" ] && cp -a "$startdir/../$d" "$dest/"
    done

    # Pacman hooks live in the package-owned system hook directory so they
    # sort together with 90-mkinitcpio-* (the post hook must run after the
    # initramfs of a new kernel exists).
    install -d "$pkgdir/usr/share/libalpm/hooks"
    install -m644 "$startdir/../hooks/alpm/"*.hook "$pkgdir/usr/share/libalpm/hooks/"

    find "$dest/bin" "$dest/install" "$dest/hardware" "$dest/tools" "$dest/hooks" -type f \( -name '*.sh' -o -name 'x' \) -exec chmod +x {} +

    install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    ln -s /usr/share/x/bin/x "$pkgdir/usr/bin/x"
}
